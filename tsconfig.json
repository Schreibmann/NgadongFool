{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictPropertyInitialization": false,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "skipLibCheck": true,
    "types": [
      "jest"
    ],
    "paths": {
      "@shared-components/*": [
        "./src/shared/components/*"
      ],
      "@shared-constants": [
        "./src/shared/constants"
      ],
      "@theme": [
        "./src/shared/theme"
      ],
      "@theme/*": [
        "./src/shared/theme/*"
      ],
      "@i18n": [
        "./src/i18n"
      ],
      "@navigation/*": [
        "./src/navigation/*"
      ],
      "@features/*": [
        "./src/features/*"
      ],
      "@assets/*": [
        "./src/assets/*"
      ]
    }
  },
  "include": [
    "App.tsx",
    "index.js",
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/types/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "babel.config.js",
    "metro.config.js"
  ]
}
