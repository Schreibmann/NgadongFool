{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": false,
    "strictPropertyInitialization": false,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "skipLibCheck": true,
    "baseUrl": "./src",
    "paths": {
      "@shared-components/*": ["./shared/components/*"],
      "@shared-constants": ["./shared/constants"],
      "@theme": ["./shared/theme"],
      "@theme/*": ["./shared/theme/*"],
      "@services/*": ["./services/*"],
      "@features/*": ["./features/*"],
      "@utils/*": ["./utils/*"],
      "@assets/*": ["./assets/*"],
      "theme": ["./shared/theme"],
      "i18n": ["./i18n"]
    }
  },
  "include": [
    "App.tsx",
    "index.js",
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/types/**/*.d.ts",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "exclude": ["node_modules", "babel.config.js", "metro.config.js"]
}
